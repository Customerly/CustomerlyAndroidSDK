# JetBrains IDEs (Android Studio / IntelliJ)
# Ignore all IDE state under .idea except the intentionally-shared whitelist
# below. Everything else (misc.xml, gradle.xml, compiler.xml, kotlinc.xml,
# vcs.xml, JDK/module paths, run-config producers, ...) is machine-specific and
# regenerated by the IDE on project import.
*.iml
*.ipr
*.iws
.idea/*
!.idea/.gitignore
!.idea/codeStyles/

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Backup files
*.bak
*.swp
*~

# Log Files
*.log
